# ---------------------------------------------------------------------------
# AI SERVİS KİMLİĞİ — örnek ortam değişkenleri
#
# Vercel: Project Settings → Environment Variables bölümüne şu değişkenleri
# ekleyin, ardından Deployments sekmesinden Redeploy yapın. Bu dosya yalnızca
# belge/örnek amacı taşır; Vercel bunu otomatik okumaz.
#
# API anahtarı: https://z.ai/manage-apikey/apikey-list  (Z.ai Açık Platform)
# ---------------------------------------------------------------------------

# Zorunlu: OpenAI-uyumlu API taban adresi (Z.ai açık platform)
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Zorunlu: kendi API anahtarınız
ZAI_API_KEY=anahtarinizi-buraya-yapistirin

# Opsiyonel: kullanılacak vision modeli — varsayılan glm-5.3-flash (vision +
# ücretsiz kademe). DİKKAT: glm-5.3-flash salt-METİN modelidir; görüntü içeren
# isteklerde reddedilir. Yalnızca vision sınıfı modeller kullanın:
# glm-5.3-flash / glm-4.6v-flash / glm-4.6v / glm-ocr
ZAI_MODEL=glm-5.3-flash

# Opsiyonel: api.z.ai gibi OpenAI-uyumlu uçlar için 'classic' bırakın
# (standart /chat/completions yolu); SDK ağ geçidi kullanıyorsanız satırı silin
ZAI_VISION_MODE=classic
